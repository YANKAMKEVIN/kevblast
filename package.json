{
  "name": "kevblast",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "npm run types && npm run unit && npm run smoke && npm run partie",
    "types": "tsc -p .",
    "unit": "node --test \"tests/unit/*.test.mjs\"",
    "smoke": "node tests/smoke.mjs",
    "partie": "node tests/partie.mjs",
    "mobile:www": "node mobile/build-www.mjs",
    "mobile:sync": "npm run mobile:www && cap sync android",
    "mobile:icones": "node mobile/icones.mjs",
    "mobile:apk": "npm run mobile:sync && cd android && ./gradlew --no-daemon assembleRelease",
    "mobile:test": "node tests/android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.3"
  }
}
